---
import PostCard from "../../components/PostCard.astro";
import { getAllPosts, tags, type Post, type Tag } from "../../data/posts";
import { findTagByRouteValue, getTagRouteParams } from "../../data/taxonomy";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getAllPosts();

  const paths = await Promise.all(
    tags.map(async (tag) =>
      getTagRouteParams(tag).map((tagParam) => ({
        params: {
          tag: tagParam
        },
        props: {
          tag,
          posts
        }
      }))
    )
  );

  return paths.flat();
}

type Props = {
  tag: Tag;
  posts: Post[];
};

const { tag, posts } = Astro.props as Props;
const resolvedTag = findTagByRouteValue(Astro.params.tag ?? tag.slug) ?? tag;
const tagPosts = posts.filter((post) =>
  post.tags.some((postTag) => postTag.slug === resolvedTag.slug)
);
---

<Layout title={`${resolvedTag.name} | てんかわ思考ログ`}>
  <div class="space-y-6">
    <header class="space-y-1">
      <p class="text-xs tracking-wide text-zinc-500">Tag / {resolvedTag.name}</p>
      <h1 class="text-xl font-semibold text-zinc-100 sm:text-2xl">{resolvedTag.name}</h1>
    </header>

    {tagPosts.map((post) => (
      <PostCard post={post} />
    ))}

    <p class="hidden rounded-xl border border-zinc-800 bg-zinc-900 px-4 py-5 text-sm text-zinc-400" data-search-empty>
      無いよ
    </p>
  </div>
</Layout>
