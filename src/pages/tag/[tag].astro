---
import PostCard from "../../components/PostCard.astro";
import { getTagHref, posts, tags, type Post, type Tag } from "../../data/posts";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return tags.map((tag) => ({
    params: {
      tag: tag.slug
    },
    props: {
      tag,
      tagPosts: posts.filter((post) =>
        post.tags.some((postTag) => postTag.slug === tag.slug)
      )
    }
  }));
}

type Props = {
  tag: Tag;
  tagPosts: Post[];
};

const { tag, tagPosts } = Astro.props as Props;
---

<Layout title={`${tag.name} | てんかわ思考ログ`}>
  <div class="space-y-6">
    <header class="space-y-1">
      <p class="text-xs tracking-wide text-zinc-500">Tag / {tag.name}</p>
      <h1 class="text-xl font-semibold text-zinc-100 sm:text-2xl">{tag.name}</h1>
    </header>

    {tagPosts.map((post) => (
      <PostCard post={post} />
    ))}

    <p class="hidden rounded-xl border border-zinc-800 bg-zinc-900 px-4 py-5 text-sm text-zinc-400" data-search-empty>
      無いよ
    </p>
  </div>
</Layout>
