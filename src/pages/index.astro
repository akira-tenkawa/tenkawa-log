---
import PostCard from "../components/PostCard.astro";
import { getAllPosts } from "../data/posts";
import Layout from "../layouts/Layout.astro";

const posts = await getAllPosts();
---

<Layout>
  <div class="space-y-6">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}

    <p class="hidden rounded-xl border border-zinc-800 bg-zinc-900 px-4 py-5 text-sm text-zinc-400" data-search-empty>
      無いよ
    </p>
  </div>
</Layout>
