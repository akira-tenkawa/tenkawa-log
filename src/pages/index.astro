---
import Layout from "../layouts/Layout.astro";
import { posts } from "../data/posts";
---

<Layout>
  <div class="space-y-8">
    {posts.map((post) => (
      <article
        class="border-b border-zinc-800 pb-8"
        data-search-item
        data-search-title={post.title}
      >
        <p class="mb-2 text-sm text-zinc-500">
          {post.date}
        </p>

        <h2 class="mb-4 text-3xl font-bold">
          {post.title}
        </h2>

        <p class="leading-8 text-zinc-400">
          {post.excerpt}
        </p>
      </article>
    ))}

    <p class="hidden rounded-xl border border-zinc-800 bg-zinc-900 px-4 py-5 text-sm text-zinc-400" data-search-empty>
      無いよ
    </p>
  </div>
</Layout>
