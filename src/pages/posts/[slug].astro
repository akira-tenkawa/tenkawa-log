---
import { render } from "astro:content";
import {
  getCategoryHref,
  getContentEntryByPost,
  getTagHref,
  getAllPosts,
  type Post
} from "../../data/posts";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post) => ({
    params: {
      slug: post.slug
    },
    props: {
      post
    }
  }));
}

type Props = {
  post: Post;
};

const { post } = Astro.props as Props;
const contentEntry = await getContentEntryByPost(post);
const { Content } = await render(contentEntry);
---

<Layout
  title={`${post.title} | てんかわ思考ログ`}
  description={post.excerpt}
  ogImage={post.ogImage}
>
  <article class="space-y-8">
    <nav
      aria-label="パンくずリスト"
      class="flex flex-wrap items-center gap-2 text-sm text-zinc-500"
    >
      <a
        href="/"
        class="inline-flex items-center text-zinc-500 no-underline hover:text-zinc-200"
        aria-label="ホーム"
      >
        <svg
          aria-hidden="true"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.8"
          viewBox="0 0 24 24"
        >
          <path d="m3.75 10.5 8.25-6.75 8.25 6.75" />
          <path d="M5.25 9.75v9.75h13.5V9.75" />
        </svg>
      </a>

      <span>/</span>

      <a
        href={getCategoryHref(post.category.slug)}
        class="text-zinc-500 no-underline hover:text-zinc-200"
      >
        {post.category.name}
      </a>

      <span>/</span>

      <span class="text-zinc-400">{post.title}</span>
    </nav>

    <header class="space-y-4">
      <h1 class="text-3xl font-bold leading-tight text-zinc-100 sm:text-4xl">
        {post.title}
      </h1>

      <div class="flex flex-wrap items-center gap-3 text-sm text-zinc-400">
        <div class="inline-flex items-center gap-2">
          <svg
            aria-hidden="true"
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <path d="M3.75 6.75A2.25 2.25 0 0 1 6 4.5h4.19a2.25 2.25 0 0 1 1.59.66l1.06 1.06a2.25 2.25 0 0 0 1.59.66H18a2.25 2.25 0 0 1 2.25 2.25V17.25A2.25 2.25 0 0 1 18 19.5H6a2.25 2.25 0 0 1-2.25-2.25V6.75Z" />
          </svg>
          <a
            href={getCategoryHref(post.category.slug)}
            class="text-zinc-400 no-underline hover:text-zinc-200"
          >
            {post.category.name}
          </a>
        </div>

        <span class="text-zinc-600">/</span>

        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-2">
            <svg
              aria-hidden="true"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              viewBox="0 0 24 24"
            >
              <path d="M8.25 7.5h-2.5a2.25 2.25 0 0 0-1.59.66l-.5.5a2.25 2.25 0 0 0 0 3.18l7 7a2.25 2.25 0 0 0 3.18 0l5-5a2.25 2.25 0 0 0 0-3.18l-7-7a2.25 2.25 0 0 0-1.59-.66h-2.5Z" />
              <path d="M7.5 7.5h.008v.008H7.5V7.5Z" />
            </svg>
            <span>タグ</span>
          </span>

          {post.tags.map((tag) => (
            <a
              href={getTagHref(tag.slug)}
              class="rounded-full bg-zinc-900 px-3 py-1 text-zinc-300 no-underline"
              data-tag-link
            >
              {tag.name}
            </a>
          ))}
        </div>

        <span class="text-zinc-600">/</span>

        <p>{post.date}</p>
      </div>
    </header>

    <div class="post-body leading-8 text-zinc-300">
      <Content />
    </div>
  </article>

  <dialog class="image-modal" data-image-modal aria-label="画像の拡大表示">
    <div class="image-modal__inner" data-image-modal-inner>
      <button
        type="button"
        class="image-modal__close"
        data-image-modal-close
        aria-label="拡大画像を閉じる"
      >
        ×
      </button>

      <img class="image-modal__image" data-image-modal-image alt="" />
    </div>
  </dialog>

  <script>
    const postBody = document.querySelector(".post-body");
    const modal = document.querySelector("[data-image-modal]");
    const modalInner = document.querySelector("[data-image-modal-inner]");
    const modalImage = document.querySelector("[data-image-modal-image]");
    const modalCloseButton = document.querySelector("[data-image-modal-close]");

    if (postBody instanceof HTMLElement) {
      if (
        modal instanceof HTMLDialogElement &&
        modalInner instanceof HTMLElement &&
        modalImage instanceof HTMLImageElement &&
        modalCloseButton instanceof HTMLButtonElement &&
        typeof modal.showModal === "function"
      ) {
        const openModal = (image) => {
          modalImage.src = image.currentSrc || image.src;
          modalImage.alt = image.alt;
          modal.showModal();
        };

        const closeModal = () => {
          modal.close();
        };

        const zoomableImages = Array.from(postBody.querySelectorAll("img")).filter(
          (image) =>
            image instanceof HTMLImageElement &&
            !(image.closest("a[href]") instanceof HTMLAnchorElement)
        );

        zoomableImages.forEach((image) => {
          image.setAttribute("data-zoomable-image", "true");
          image.addEventListener("click", () => {
            openModal(image);
          });
        });

        modalCloseButton.addEventListener("click", closeModal);

        modal.addEventListener("click", (event) => {
          if (!modalInner.contains(event.target)) {
            closeModal();
          }
        });

        modal.addEventListener("close", () => {
          modalImage.removeAttribute("src");
          modalImage.alt = "";
        });
      }

      const copyCodeText = async (text) => {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return;
        }

        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "absolute";
        textarea.style.left = "-9999px";
        document.body.append(textarea);
        textarea.select();
        document.execCommand("copy");
        textarea.remove();
      };

      const codeBlocks = Array.from(postBody.querySelectorAll("pre")).filter(
        (codeBlock) => codeBlock instanceof HTMLPreElement
      );

      codeBlocks.forEach((codeBlock) => {
        const codeElement = codeBlock.querySelector("code");
        const codeText = codeElement?.textContent?.trimEnd();

        if (!codeElement || !codeText) {
          return;
        }

        const copyButton = document.createElement("button");
        let copiedTimer = 0;

        copyButton.type = "button";
        copyButton.className = "code-copy-button";
        copyButton.setAttribute("aria-label", "コードをコピー");
        copyButton.setAttribute("title", "コードをコピー");
        copyButton.innerHTML = `
          <svg
            class="code-copy-button__icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="9" y="9" width="10" height="10" rx="2"></rect>
            <path d="M15 9V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path>
          </svg>
          <svg
            class="code-copy-button__check"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6.5 12.5 3.5 3.5 7.5-8"></path>
          </svg>
        `;

        copyButton.addEventListener("click", async () => {
          try {
            await copyCodeText(codeText);
            copyButton.dataset.copied = "true";
            window.clearTimeout(copiedTimer);
            copiedTimer = window.setTimeout(() => {
              delete copyButton.dataset.copied;
            }, 1800);
          } catch {
            window.clearTimeout(copiedTimer);
          }
        });

        codeBlock.append(copyButton);
      });
    }
  </script>
</Layout>
