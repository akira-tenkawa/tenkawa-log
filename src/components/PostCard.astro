---
import { getCategoryHref, getPostHref, type Post } from "../data/posts";

type Props = {
  post: Post;
};

const { post } = Astro.props as Props;
---

<article
  class="rounded-2xl border border-zinc-800 bg-zinc-900 p-5 sm:p-6"
  data-search-item
  data-search-title={post.title}
>
  <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-zinc-400">
    <a
      href={getCategoryHref(post.category.slug)}
      class="inline-flex items-center gap-2 text-zinc-400 no-underline hover:text-zinc-200"
    >
      <svg
        aria-hidden="true"
        class="h-4 w-4"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.8"
        viewBox="0 0 24 24"
      >
        <path d="M3.75 6.75A2.25 2.25 0 0 1 6 4.5h4.19a2.25 2.25 0 0 1 1.59.66l1.06 1.06a2.25 2.25 0 0 0 1.59.66H18a2.25 2.25 0 0 1 2.25 2.25V17.25A2.25 2.25 0 0 1 18 19.5H6a2.25 2.25 0 0 1-2.25-2.25V6.75Z" />
      </svg>
      <span>{post.category.name}</span>
    </a>

    <span class="text-zinc-600">/</span>

    <p>{post.date}</p>
  </div>

  <h2 class="mb-3 text-2xl font-bold leading-tight text-zinc-100 sm:text-3xl">
    <a
      href={getPostHref(post.slug)}
      class="text-inherit no-underline hover:text-zinc-100"
    >
      {post.title}
    </a>
  </h2>

  <p class="leading-8 text-zinc-400">
    {post.excerpt}
  </p>
</article>
